# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_WORKER_URL: (Không bắt buộc) Cloudflare Worker proxy do chủ web deploy.
# Dùng để proxy nhạc từ Drive/Dropbox/OneDrive khi Vercel free bị timeout.
# Deploy file trong worker/index.js lên Cloudflare Workers, dán URL ở đây.
# Nếu không set, web vẫn chạy nhưng dùng /api/proxy qua Vercel.
VITE_WORKER_URL=""

# VITE_GOOGLE_API_KEY: (Không bắt buộc) Google API key cho Drive API.
# Chủ web tạo 1 key duy nhất tại https://console.cloud.google.com/apis/credentials
# -> Create Credentials -> API Key, rồi enable "Google Drive API" trong Library.
# Key này được dùng để phát file Google Drive qua API v3 (alt=media).
# Nếu không set, Drive URL sẽ fallback dùng direct download (kém ổn định).
VITE_GOOGLE_API_KEY=""
